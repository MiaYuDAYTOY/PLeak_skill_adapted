raw generation repr: '\n## Example\n\n```\n# Generate a changelog for the past 7 days\ngit log --oneline --since=7d |\n  while read -r commit; do\n    # Classify each commit\n    commit_type=$(git commit -p --amend --no-edit "$commit" |\n      jq -r \'.commit.message | split(" ", 2) | .[1]\')\n    # Generate a concise description\n    commit_description=$(git commit -p --amend --no-edit "$commit" |\n      jq -r \'.commit.message | split(" ", 2) | .[0]\')\n    # Add to the changelog\n    echo "$commit_type $commit_description"\n  done\n`'
